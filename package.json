{
  "name": "running-training-dataset",
  "version": "0.0.0",
  "private": true,
  "description": "러닝 훈련법의 브라우징 카탈로그: 각 훈련법이 무엇에 베팅하는지, 실행 비용은 얼마인지, 실제로 알려진 것은 어디까지인지.",
  "homepage": "https://github.com/cbcruk/running-training-dataset#readme",
  "bugs": {
    "url": "https://github.com/cbcruk/running-training-dataset/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cbcruk/running-training-dataset.git"
  },
  "type": "module",
  "scripts": {
    "dev": "node --watch --import remix/node-tsx server.ts",
    "build": "NODE_ENV=production BASE_PATH=${BASE_PATH:-/running-training-dataset/} node --import remix/node-tsx scripts/prerender.ts",
    "preview": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "validate": "node --import remix/node-tsx scripts/validate.ts",
    "render": "node --import remix/node-tsx scripts/render.ts",
    "types": "node --import remix/node-tsx scripts/types.ts",
    "verify": "node --import remix/node-tsx scripts/verify.ts",
    "pages": "pnpm run build",
    "test": "NODE_ENV=test node --import remix/node-tsx --test \"tests/**/*.test.ts\"",
    "check": "vp check",
    "prepare": "vp config"
  },
  "dependencies": {
    "remix": "3.0.0-beta.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "ajv": "^8.20.0",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.4"
  },
  "packageManager": "pnpm@11.15.1"
}

{
  "name": "running-training-dataset",
  "version": "0.0.0",
  "private": true,
  "description": "러닝 훈련법의 브라우징 카탈로그: 각 훈련법이 무엇에 베팅하는지, 실행 비용은 얼마인지, 실제로 알려진 것은 어디까지인지.",
  "homepage": "https://github.com/cbcruk/running-training-dataset#readme",
  "bugs": {
    "url": "https://github.com/cbcruk/running-training-dataset/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cbcruk/running-training-dataset.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "NODE_ENV=production BASE_PATH=${BASE_PATH:-/running-training-dataset/} vite build && vite-node scripts/pages-404.ts",
    "preview": "vite preview",
    "validate": "vite-node scripts/validate.ts",
    "render": "vite-node scripts/render.ts",
    "types": "vite-node scripts/types.ts",
    "verify": "vite-node scripts/verify.ts",
    "pages": "pnpm run build",
    "test": "NODE_ENV=test vite-node tests/dataset.test.ts",
    "check": "vp check",
    "prepare": "vp config"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.29",
    "@tanstack/react-start": "^1.168.46",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "ajv": "^8.20.0",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-node": "^6.0.0",
    "vite-plus": "^0.2.4"
  },
  "packageManager": "pnpm@11.15.1"
}
